SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置（MySQL）
DB_ENGINE=django.db.backends.mysql
DB_NAME=aigc_poster_db
DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=3306

# 智谱 AI API Key（免费，从 https://bigmodel.cn/ 注册获取）
# 使用的模型均为免费模型：GLM-4-Flash（文案）、CogView-3-Flash（图像）
# 不使用收费的 GPT / OpenAI API
ZHIPUAI_API_KEY=<redacted>

# 图像生成后端（双后端可切换）
# zhipu = 智谱 CogView-3-Flash 免费云端 API（默认，联网即可用）
# sd    = 本地 Stable Diffusion WebUI API（需本地启动 SD WebUI 并加 --api 参数）
IMAGE_BACKEND=zhipu
SD_API_URL=http://127.0.0.1:7860/sdapi/v1/txt2img
